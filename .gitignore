# ==========================================
# Root .gitignore - Meta Lead Ads Real-Time Gateway & Mobile App
# ==========================================

# Environment & Secrets (CRITICAL: NEVER COMMIT REAL KEYS)
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
mobile/.env
mobile/.env.*
!mobile/.env.example

# Video Recordings & Large Media (Loom recordings, screen captures, executables)
*.exe
*.exe.*
.ngrok*
cloudflared*
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.loom
*.gif
LOOM_VIDEO_SCRIPTS.md
recordings/
videos/
screencasts/

# Dependencies
node_modules/
backend/node_modules/
mobile/node_modules/
.pnp
.pnp.js

# Build Outputs & Compilations
backend/dist/
backend/build/
mobile/dist/
mobile/web-build/
mobile/.expo/
mobile/.expo-shared/
*.tsbuildinfo

# Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS Files & Temporary Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor Settings
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Test & Coverage Outputs
coverage/
.nyc_output/
*.lcov
