PORT=4000
CORS_ORIGIN=*

# Meta Webhook Verification Token (Configure in Meta Developer App Dashboard)
META_VERIFY_TOKEN=your_custom_webhook_verify_token_here

# Meta App Secret (Used for cryptographic HMAC-SHA256 signature verification)
META_APP_SECRET=your_meta_app_secret_here

# Meta Page Access Token (Used to query Meta Graph API for lead form field values)
META_PAGE_ACCESS_TOKEN=your_meta_page_access_token_here

# Meta Graph API Version
META_GRAPH_API_VERSION=v19.0
